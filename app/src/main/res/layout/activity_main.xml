<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_gradient"
    android:padding="16dp"
    android:gravity="center">

    <!-- 💰 En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🐻 Doudou Gris"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#5D4037"/>

        <TextView
            android:id="@+id/text_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 100"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FF9800"/>
    </LinearLayout>

    <!-- 📊 Barres de statut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFFCC"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🍖 Faim" android:textSize="12sp" android:textColor="#E65100"/>
        <ProgressBar android:id="@+id/status_hunger" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="12dp"
            android:progress="80" android:progressTint="#FF9800" android:layout_marginBottom="8dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="❤️ Joie" android:textSize="12sp" android:textColor="#C2185B"/>
        <ProgressBar android:id="@+id/status_happy" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="12dp"
            android:progress="70" android:progressTint="#E91E63" android:layout_marginBottom="8dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚡ Énergie" android:textSize="12sp" android:textColor="#FFC107"/>
        <ProgressBar android:id="@+id/status_energy" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="12dp"
            android:progress="90" android:progressTint="#FFC107"/>
    </LinearLayout>

    <!-- 💬 Bulle de message -->
    <TextView
        android:id="@+id/text_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:textColor="#333333"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="3dp"
        android:layout_marginBottom="16dp"
        android:minWidth="200dp"
        android:gravity="center"/>

    <!-- 🐻 Doudou -->
    <ImageView
        android:id="@+id/doudou_image"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:src="@drawable/ic_doudou_happy"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp"/>

    <!-- 🎮 Boutons d'action - Ligne 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <ImageView android:id="@+id/btn_talk" android:layout_width="0dp" android:layout_height="65dp"
            android:layout_weight="1" android:src="@drawable/btn_talk_bg" android:layout_margin="6dp"
            android:clickable="true" android:focusable="true" android:elevation="2dp"/>
        <ImageView android:id="@+id/btn_feed" android:layout_width="0dp" android:layout_height="65dp"
            android:layout_weight="1" android:src="@drawable/btn_feed_bg" android:layout_margin="6dp"
            android:clickable="true" android:focusable="true" android:elevation="2dp"/>
        <ImageView android:id="@+id/btn_drink" android:layout_width="0dp" android:layout_height="65dp"
            android:layout_weight="1" android:src="@drawable/btn_drink_bg" android:layout_margin="6dp"
            android:clickable="true" android:focusable="true" android:elevation="2dp"/>
    </LinearLayout>

    <!-- 🎮 Boutons d'action - Ligne 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView android:id="@+id/btn_pet" android:layout_width="0dp" android:layout_height="65dp"
            android:layout_weight="1" android:src="@drawable/btn_pet_bg" android:layout_margin="6dp"
            android:clickable="true" android:focusable="true" android:elevation="2dp"/>
        <ImageView android:id="@+id/btn_play" android:layout_width="0dp" android:layout_height="65dp"
            android:layout_weight="1" android:src="@drawable/btn_play_bg" android:layout_margin="6dp"
            android:clickable="true" android:focusable="true" android:elevation="2dp"/>
        <ImageView android:id="@+id/btn_sleep" android:layout_width="0dp" android:layout_height="65dp"
            android:layout_weight="1" android:src="@drawable/btn_sleep_bg" android:layout_margin="6dp"
            android:clickable="true" android:focusable="true" android:elevation="2dp"/>
    </LinearLayout>

</LinearLayout>
