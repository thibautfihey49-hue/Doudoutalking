<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp"
    android:background="#F5F5F5">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🐻 Doudou Gris" android:textSize="28sp" android:textStyle="bold"
        android:layout_marginBottom="30dp"/>
    <ImageView android:id="@+id/doudou_image" android:layout_width="200dp"
        android:layout_height="200dp" android:src="@drawable/ic_doudou"
        android:layout_marginBottom="30dp" android:clickable="true"/>
    <EditText android:id="@+id/input_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Écris quelque chose..."
        android:inputType="textMultiLine" android:minLines="2"
        android:backgroundTint="#757575" android:layout_marginBottom="16dp"/>
    <Button android:id="@+id/btn_parler" android:layout_width="match_parent"
        android:layout_height="60dp" android:text="🗣️ Faire parler Doudou"
        android:backgroundTint="#607D8B" android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>
    <Button android:id="@+id/btn_toucher" android:layout_width="match_parent"
        android:layout_height="60dp" android:text="👋 Toucher le doudou"
        android:backgroundTint="#90A4AE" android:textColor="#FFFFFF"/>
</LinearLayout>
